import re
import pyperclip
import requests
import os
import random
avarias = []
funcionais = []
quebrados = []
proxies= {
       "http": "socks5h://192.168.100.225:9150",
       "https": "socks5h://192.168.100.225:9150"
}
nome_pasta = input("Escolha um Nome para Seu arquivo Com links avariados: ")
nome_pasta_200 = input("Agora o nome para os Links Funcionais: ")
area_transferencia = pyperclip.paste()
regexp = re.compile(r"\S+\.onion\b",flags=re.I) 
links_achados = regexp.findall(area_transferencia) 
for i in links_achados:
    try:
        a = random.randint(15,30)
        r = requests.get(i,proxies=proxies,timeout=a)
        r1 = r.status_code
        if r1 != 200:
            print(f"Site: [{i}] Code: [{r1}]")
            avarias.append(f"Site: {i} Code: [{r1}]")
        else:
            print((f"Site: [{i}] Code: [{r1}]"))
            funcionais.append(f"Site: [{i}] Code: [{r1}]")


    except Exception as erro:
        quebrados.append(f"Site: [{i}] Code: [{erro}]")
        continue

with open(f"{nome_pasta}.txt","w") as arquivo:
                arquivo.write("\n".join(avarias))

with open(f"{nome_pasta_200}.txt","w") as links_200:
                links_200.write("\n".join(funcionais))
                
with open(f"crazy_links.txt","w") as crack:
            crack.write("\n".join(quebrados))
