import random #imported librasys: os and random
import os

def l(): # function that clear terminal
    if os.name == "nt":
         os.system("cls")

# choices a random word in (aleatoria)
aleatoria = ['Janela', 'Satélite', 'Abacaxi', 'Tempestade', 'Circuito', 'Relógio', 'Horizonte', 'Nebulosa', 'Martelo', 'Biblioteca', 'Eco', 'Cristal', 'Mochila', 'Pixel', 'Vulcão', 'Lanterna', 'Engrenagem', 'Oceano', 'Cometa', 'Algoritmo', 'Floresta', 'Xícara', 'Ponte', 'Gravidade', 'Prisma', 'Trovão', 'Labirinto', 'Teclado', 'Cachoeira', 'Saturno', 'Bambu', 'Radar', 'Origem', 'Foguete', 'Caramelo', 'Caderno', 'Coral', 'Ímã', 'Chuva', 'Eclipse', 'Corda', 'Espelho', 'Galáxia', 'Nuvem', 'Bússola', 'Farol', 'Código', 'Ventania', 'Colmeia', 'Diamante']
palavra_secreta= random.choice(aleatoria).lower() # random (secret word)
tentativas = 0 # attemps
acertou = "" # hit a letter

while True:
    try:
        letra_d = input("Guess a secret word: ") 
        tentativas +=1

        if len(letra_d)> 1:
            print("just One letter at a time...")
            continue
        if letra_d in palavra_secreta:
            acertou += letra_d

        final = ''

        for i in palavra_secreta:
            if i in acertou:
                final += i 
            else:
                final += "*"

        print(final)

        if final == palavra_secreta:
            print(f"Voce ganhou, palavra: {palavra_secreta}\n"
                f"Tentativas: {tentativas}\n")
            new_attemp = input("Tentar novamente? [s/n]: ").lower().startswith("s")
            if new_attemp == True:
                tentativas = 0
                acertou = ""
                palavra_secreta= random.choice(aleatoria).lower()
                continue
            else:
                print("exit...")
                break
            
    except KeyboardInterrupt:
        print("Guess letters...")
        new_attemp = input("Exit? [y/n]: ").lower().startswith("y")
        if new_attemp == True:
            tentativas = 0
            acertou = ""
            palavra_secreta= random.choice(aleatoria).lower()
            continue
        else:
            print("exit...")
            break
